snippet bin "binary search functions"
template <typename T, typename F>
T first_true(T lo, T hi, F pred) {
	while (lo < hi) { T mid = lo + (hi - lo) / 2;
		if (pred(mid)) hi = mid; else lo = mid + 1; }
	return lo;
}
template <typename T, typename F>
T last_true(T lo, T hi, F pred) {
	while (lo < hi) { T mid = lo + (hi - lo) / 2;
		if (pred(mid)) lo = mid + 1; else hi = mid; }
	return lo - 1;
}
template <typename F>
_ld first_true_real(_ld lo, _ld hi, F pred, int iters = 100) {
	while (iters--) { _ld mid = (lo + hi) / 2;
		if (pred(mid)) hi = mid; else lo = mid; }
	return lo;
}
endsnippet




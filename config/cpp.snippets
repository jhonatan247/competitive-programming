snippet cross "corss product"
_l$1 cross(_p${1:l} &a, _p$1 &b) { 
	return  a.fr * b.sc - a.sc * b.fr;
} 
endsnippet



snippet cycles "short cycles"
#define F0Rd(i,a) for (_ll i = (a)-1; i >= 0; i--)
#define FOR(i, a, b) for (_ll i=a; i<(b); i++)
#define FORd(i,a,b) for (_ll i = (b)-1; i >= a; i--)
#define TRAV(a,x) for (auto& a : x)
#define TRAVd(a,x) for (auto a = x.rbegin(); a != x.rend(); ++a)
endsnippet




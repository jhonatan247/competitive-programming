	$0
}
endsnippet



snippet ford "custom decreasing for"
FORd(${1:i}, ${2:1}, ${2:n}) {
	$0
}
endsnippet



snippet fordz "custom decreasing for from sz(arr)"
FORd(${1:i}, ${2:1}, sz(${2:arr})) {
	$0
}
endsnippet



snippet foreach "for iterating over a collection"
TRAV(${1:e}, ${2:arr}) {
	$0
}
endsnippet



snippet foreachd "for iterating over a collection in reverse order"
TRAVd(${1:e}It, ${2:arr}) {
	auto $1 = *$1It;
	$0
}
endsnippet



snippet gcd "gcd"
template<typename T>
T gcd(T a, T b) {
while (a) {
b %= a;
swap(a, b);
}
return b;
}
endsnippet



snippet inf "infinitive numbers for comparisons"
const int INF  =  1e9;
const int NINF = -1e9;
endsnippet




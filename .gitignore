# 1. Ignore everything
*

# 2. Do not ignore directories (otherwise Git won't look inside them for .cpp files)
!*/

# 3. Do not ignore code files
!*.cpp
*_compiled.cpp
!*.h
!*.hpp
!*.md
!*.py
!*.sh
!*.snippets
!*.vimrc

# Keep a normal project-level ignore policy under repository/
!/repository/
!/repository/**
!/.github/
!/.github/**

# 4. Optional: Do not ignore the .gitignore file itself
!.gitignore
